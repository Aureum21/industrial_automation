# Copy to .env.local for local development. Never commit real values.

# Neon (or other Postgres) connection string. Without it the site still runs:
# the simulator and built-in articles work, but accounts and the Studio are disabled.
DATABASE_URL=

# Optional, fresh databases only: creates the owner account (username alex_eng_aut)
# on first start if no owner exists yet. Remove it after the first sign-in.
OWNER_INITIAL_PASSWORD=

# Local development only: send queries to scripts/local-db-proxy.mjs instead of Neon.
# Example: NEON_FETCH_ENDPOINT=http://localhost:4444/sql
NEON_FETCH_ENDPOINT=
