22%20stroke-width%3D%221%22%2F%3E%0A%20%20%20%20%3Ctext%20x%3D%2216%22%20y%3D%2222%22%20fill%3D%22%23f59e0b%22%20font-family%3D%22ui-monospace%2C%20monospace%22%20font-size%3D%2210%22%20font-weight%3D%22bold%22%3E%0A%20%20%20%20%20%20%E2%97%8F%20SOLAR%20SIGNAL%20CONDITIONING%20RULES%0A%20%20%20%20%3C%2Ftext%3E%0A%20%20%20%20%3Cline%20x1%3D%2216%22%20y1%3D%2228%22%20x2%3D%221024%22%20y2%3D%2228%22%20stroke%3D%22%231e293b%22%20stroke-width%3D%221%22%2F%3E%0A%0A%20%20%20%20%3Ctext%20x%3D%2216%22%20y%3D%2246%22%20fill%3D%22%2394a3b8%22%20font-family%3D%22ui-monospace%2C%20monospace%22%20font-size%3D%228.5%22%3E%0A%20%20%20%20%20%201.%20TRANSIENT%20REJECTION%3A%20Passing%20clouds%20cause%20instantaneous%2040%25%20voltage%20dips.%20Raw%20readings%20cause%20false%20alarms%20and%20contactor%20chattering.%0A%20%20%20%20%3C%2Ftext%3E%0A%20%20%20%20%3Ctext%20x%3D%2216%22%20y%3D%2262%22%20fill%3D%22%2310b981%22%20font-family%3D%22ui-monospace%2C%20monospace%22%20font-size%3D%228.5%22%20font-weight%3D%22bold%22%3E%0A%20%20%20%20%20%202.%20MOVING%20AVERAGE%3A%205-sample%20smoothing%20eliminates%20cloud%20jitter%20while%20tracking%20true%20solar%20output%20trends%20with%20minimal%20phase%20delay.%0A%20%20%20%20%3C%2Ftext%3E%0A%20%20%20%20%3Ctext%20x%3D%2216%22%20y%3D%2278%22%20fill%3D%22%2338bdf8%22%20font-family%3D%22ui-monospace%2C%20monospace%22%20font-size%3D%228.5%22%3E%0A%20%20%20%20%20%203.%20TELEMETRY%20EFFICIENCY%3A%20DATA_LOG%20samples%20every%20500ms%20to%20preserve%20cellular%20bandwidth%20and%20avoid%20memory%20overflow%20on%20remote%20microgrids.%0A%20%20%20%20%3C%2Ftext%3E%0A%20%20%3C%2Fg%3E%0A%3C%2Fsvg%3E%0A",
      "caption": "FIG 1.1 // REMOTE SOLAR PV MICROGRID TELEMETRY & MOVING AVERAGE DATA LOGGER",
      "alt": "Solar array telemetry and moving average signal conditioning schematic"
